---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const featuredProjects = (
  await getCollection("projects", ({ data }) => data.featured)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Cedric Orton-Urbina"
  description="The technical portfolio of Cedric Orton-Urbina, specializing in scientific computing, simulation, machine learning, and aerospace research."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">
        Scientific computing · Simulation · Machine learning
      </p>

      <h1>
        I build computational tools for scientific and engineering problems.
      </h1>

      <p class="hero-description">
        I am a computer scientist and computational researcher interested in
        physics-based simulation, aerospace, astronomy, and high-performance
        computing.
      </p>

      <div class="hero-actions">
        <a class="primary-link" href="#projects">
          View selected projects
        </a>

        <a class="secondary-link" href="/resume.pdf">
          View résumé
        </a>
      </div>
    </div>
  </section>

  <section
    id="projects"
    class="page-section"
    aria-labelledby="projects-heading"
  >
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2 id="projects-heading">Projects</h2>
      </div>

      <div class="project-grid">
		{
			featuredProjects.map((project) => (
			<ProjectCard project={project} />
			))
		}
	  </div>
    </div>
  </section>

  <section
    id="about"
    class="page-section"
    aria-labelledby="about-heading"
  >
    <div class="container narrow-content">
      <p class="eyebrow">Background</p>
      <h2 id="about-heading">About</h2>

      <p class="section-copy">
        My work combines computer science with physical modeling and
        quantitative research. I am particularly interested in software that
        makes complex physical systems easier to simulate, analyze, and
        understand.
      </p>
    </div>
  </section>

  <section
    id="contact"
    class="page-section"
    aria-labelledby="contact-heading"
  >
    <div class="container narrow-content">
      <p class="eyebrow">Get in touch</p>
      <h2 id="contact-heading">Contact</h2>

      <p class="section-copy">
        I am interested in opportunities involving scientific software,
        physics-based simulation, aerospace, and computational research.
      </p>

      <ul class="contact-links">
        <li>
          <a href="mailto:your-email@example.com">Email</a>
        </li>
        <li>
          <a href="https://github.com/YOUR-USERNAME">GitHub</a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/YOUR-USERNAME">
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  .hero .container {
    max-width: var(--page-width);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 15ch;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
  }

  .hero-description {
    max-width: 42rem;
    margin-top: var(--space-8);
    color: var(--color-text-muted);
    font-size: clamp(1.125rem, 2vw, 1.35rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .primary-link,
  .secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding-inline: var(--space-6);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-small);
    font-weight: 700;
    text-decoration: none;
  }

  .primary-link {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .primary-link:hover {
    background: var(--color-accent-dark);
    color: var(--color-surface);
  }

  .secondary-link {
    background: transparent;
    color: var(--color-accent);
  }

  .secondary-link:hover {
    border-color: var(--color-accent-dark);
  }

  .page-section {
    padding-block: var(--space-16);
  }

  .section-heading {
    margin-bottom: var(--space-8);
  }

  .section-heading h2,
  .narrow-content h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .narrow-content {
    max-width: var(--content-width);
  }

  .section-copy {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .contact-links a {
    font-weight: 700;
  }

</style>