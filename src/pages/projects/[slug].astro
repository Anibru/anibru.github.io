---
import type { GetStaticPaths } from "astro";

import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  projects,
  type Project
} from "../../data/projects";

export const getStaticPaths = (() => {
  return projects.map((project) => ({
    params: {
      slug: project.slug
    },
    props: {
      project
    }
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={project.title}
  description={project.summary}
>
  <article class="project-page">
    <div class="container project-container">
      <a class="back-link" href="/projects/">
        ← All projects
      </a>

      <header class="project-header">
        <p class="project-category">
          {project.category}
        </p>

        <h1>{project.title}</h1>

        <p class="project-summary">
          {project.summary}
        </p>
      </header>

      <div class="project-content">
        <section aria-labelledby="problem-heading">
          <h2 id="problem-heading">Problem</h2>
          <p>{project.problem}</p>
        </section>

        <section aria-labelledby="approach-heading">
          <h2 id="approach-heading">Approach</h2>
          <p>{project.approach}</p>
        </section>

        <section aria-labelledby="outcome-heading">
          <h2 id="outcome-heading">Outcome</h2>
          <p>{project.outcome}</p>
        </section>

        <section aria-labelledby="technologies-heading">
          <h2 id="technologies-heading">Technologies</h2>

          <ul
            class="technology-list"
            aria-label={`Technologies used for ${project.title}`}
          >
            {
              project.technologies.map((technology) => (
                <li>{technology}</li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-block: var(--space-12);
  }

  .project-container {
    max-width: var(--content-width);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-12);
    font-weight: 700;
  }

  .project-category {
    margin-bottom: var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-header h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .project-summary {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: 1.25rem;
  }

  .project-content {
    display: grid;
    gap: var(--space-12);
    margin-top: var(--space-16);
  }

  .project-content h2 {
    margin-bottom: var(--space-4);
    font-size: 1.5rem;
  }

  .project-content p {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .technology-list li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>