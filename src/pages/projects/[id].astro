---
import { Image } from "astro:assets";

import {
  getCollection,
  render,
  type CollectionEntry
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectResources
  from "../../components/ProjectResources.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      id: project.id
    },
    props: {
      project
    }
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
>
  <article class="project-page">
    <div class="container project-container">
      <a class="back-link" href="/projects/">
        ← All projects
      </a>

      <header class="project-header">
        <p class="project-category">
          {project.data.category}
        </p>

        <h1>
          {project.data.title}
        </h1>

        <p class="project-summary">
          {project.data.summary}
        </p>

        <ul
          class="technology-list"
          aria-label={`Technologies used for ${project.data.title}`}
        >
          {
            project.data.technologies.map((technology) => (
              <li>{technology}</li>
            ))
          }
        </ul>

        {
          project.data.heroImage && project.data.heroAlt && (
            <Image
              class="project-hero"
              src={project.data.heroImage}
              alt={project.data.heroAlt}
            />
          )
        }
      </header>

      <div class="project-content">
        <Content />
      </div>

      <ProjectResources
      resources={project.data.resources}
      />
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-block: var(--space-12);
  }

  .project-container {
    max-width: var(--content-width);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-12);
    font-weight: 700;
  }

  .project-category {
    margin-bottom: var(--space-4);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-header h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .project-summary {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: 1.25rem;
  }

  .project-content {
  margin-top: var(--space-16);
  }

  .project-content :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-size: 1.5rem;
  }

  .project-content :global(p) {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    margin-top: var(--space-4);
  }

  .project-hero {
  width: 100%;
  margin-top: var(--space-8);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-medium);
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .technology-list li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>